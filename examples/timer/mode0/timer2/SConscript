Import("env")

ms_freq_progs = SConscript('ms_freq/SConscript', exports = 'env')

timer2_mode0_1T_interrupt_prog = env.Program(
    'timer2_mode0_1T_interrupt_example',
    ['timer2_mode0_1T_interrupt_example.c']
)

timer2_mode0_P30_output_prog = env.Program(
    'timer2_mode0_P30_output_example',
    ['timer2_mode0_P30_output_example.c']
)

timer2_mode0_reload_prog = env.Program(
    'timer2_mode0_reload_example',
    ['timer2_mode0_reload_example.c']
)

timer2_mode0_direct_reload_prog = env.Program(
    'timer2_mode0_direct_reload_example',
    ['timer2_mode0_direct_reload_example.c']
)

timer2_mode0_ms_to_ticks_prog = env.Program(
    'timer2_mode0_ms_to_ticks_example',
    ['timer2_mode0_ms_to_ticks_example.c']
)

timer2_mode0_ticks_to_ms_prog = env.Program(
    'timer2_mode0_ticks_to_ms_example', 
    ['timer2_mode0_ticks_to_ms_example.c']
)

timer2_mode0_ticks_to_Hz_prog = env.Program(
    'timer2_mode0_ticks_to_Hz_example',
    ['timer2_mode0_ticks_to_Hz_example.c']
)

timer2_mode0_Hz_to_ticks_prog = env.Program(
    'timer2_mode0_Hz_to_ticks_example',
    ['timer2_mode0_Hz_to_ticks_example.c']
)

env.Default(
    timer2_mode0_1T_interrupt_prog,
    timer2_mode0_P30_output_prog,
    timer2_mode0_reload_prog,
    timer2_mode0_direct_reload_prog,
    timer2_mode0_ms_to_ticks_prog,
    timer2_mode0_ticks_to_ms_prog,
    timer2_mode0_ticks_to_Hz_prog,
    timer2_mode0_Hz_to_ticks_prog
)

Return([
    'ms_freq_progs',
    'timer2_mode0_1T_interrupt_prog',
    'timer2_mode0_P30_output_prog',
    'timer2_mode0_reload_prog',
    'timer2_mode0_direct_reload_prog',
    'timer2_mode0_ms_to_ticks_prog',
    'timer2_mode0_ticks_to_ms_prog',
    'timer2_mode0_ticks_to_Hz_prog',
    'timer2_mode0_Hz_to_ticks_prog'
])
